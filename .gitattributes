# Los artefactos cuyo hash verifica el paquete viajan como bytes exactos: si
# Git normaliza sus finales de línea, el clon del alojamiento produce un hash
# distinto del aprobado y la verificación falla (o, peor, pasa sobre bytes que
# nadie auditó).
vendor/** -text
*.min.js -text
# index.html es la FUENTE cuyo hash firma el paquete y la suite: si git
# normaliza sus finales de línea, el clon del alojamiento construye un
# artefacto con otra huella que la verificada y `verify:site` falla.
index.html -text
*.png binary
*.pdf binary
*.docx binary

# El código y los documentos sí se normalizan a LF en el repositorio.
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

.gitignore text eol=lf
.gitattributes text eol=lf
