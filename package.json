{
  "name": "futuria-app7-anonimizador",
  "version": "1.0.0",
  "private": true,
  "description": "Build estático de App7; index.html es la fuente editable canónica.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
